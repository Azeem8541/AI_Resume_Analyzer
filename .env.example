# Copy this file to .env (or set these as real environment variables / in your IDE run config)
# NEVER commit the real .env file or real secrets to git.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_resume_analyzer
DB_USERNAME=root
DB_PASSWORD=change-me

# --- JWT ---
# Must be a long, random, secret string (32+ chars). Generate with e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# --- Gemini AI ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=change-me

# --- Optional overrides ---
SERVER_PORT=8080
DDL_AUTO=update
SHOW_SQL=false
UPLOAD_DIR=uploads/
